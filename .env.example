# Supabase project settings. The anon key is safe to use only with RLS enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-or-publishable-key

# Browser-side Supabase settings. Point these at the same project as SUPABASE_URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Signup and password-recovery emails are delivered by Supabase Auth.
# Configure SMTP and allowed redirect URLs in the Supabase dashboard, not here.

# Required by admin API routes and scheduled transaction cleanup. Keep server-only;
# never expose it to the browser or use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Supabase session-mode PostgreSQL pooler URL; include sslmode=require in production.
# Keep this server-only and URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

# Generate a random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret

# Exact browser origin; use HTTPS in production.
APP_URL=http://localhost:3000

# Required on Vercel for the scheduled two-month transaction cleanup.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it server-only.
CRON_SECRET=

# Optional; smart transaction parsing falls back to local rules without it.
GEMINI_API_KEY=

# Optional; only set this when running behind a known number of trusted proxies (1-5).
TRUST_PROXY_HOPS=

# Optional local Express port; defaults to 3000.
PORT=3000
